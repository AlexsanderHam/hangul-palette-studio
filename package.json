{
  "name": "hangul-palette-studio",
  "version": "1.0.0",
  "description": "Build, preview and export Hangul Palette color webfonts from Pretendard.",
  "type": "module",
  "license": "MIT",
  "author": "Alexsander Ham",
  "private": true,
  "keywords": [
    "hangul",
    "korean",
    "color-font",
    "palette",
    "pretendard",
    "font",
    "glyph",
    "studio"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "extract": "bun bin/extract.ts",
    "start": "bun bin/serve.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun test",
    "setup:font": "bun bin/setup-font.ts",
    "release": "bun bin/release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/bun": "^1.3.12",
    "typescript": "^6"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
